  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [],
  "homepage": "https://github.com/cabrera-evil/npm-lib-template",
  "bugs": {
    "url": "https://github.com/cabrera-evil/npm-lib-template/issues"
  },
  "repository": {
    "type": "git",
