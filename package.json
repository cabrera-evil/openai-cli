  "author": {
    "name": "cabrera-evil",
    "email": "douglascabrera.dev@gmail.com"
  },
  "maintainers": [
    {
      "name": "cabrera-evil",
      "email": "douglascabrera.dev@gmail.com"
    }
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index",
    "start": "ts-node -r tsconfig-paths/register dist/index",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "lint:fix": "pnpm lint && pnpm format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "pnpm lint:check",
      "pnpm format:check"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.18",
    "ai": "^4.0.33",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.3.0",
    "joi": "^17.13.3",
    "openai": "^4.78.1",
    "ora": "^8.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.1"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  }
}